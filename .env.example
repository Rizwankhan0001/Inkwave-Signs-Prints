# Copy to .env and fill in. All are optional — features switch on when a value is set.

# Site address for hosts other than Netlify (canonical URLs, sitemap, link previews).
# Not needed on Netlify: it uses the site's primary domain automatically.
SITE_URL=

# Google Analytics 4 measurement ID (tracks visits + call/WhatsApp/form leads)
PUBLIC_GA_ID=

# Google Search Console & Bing Webmaster verification codes
PUBLIC_GSC_VERIFICATION=
PUBLIC_BING_VERIFICATION=

# Free lead storage: get a key at https://web3forms.com — every form is then emailed to you
PUBLIC_WEB3FORMS_KEY=
