---
import Page from "../../layouts/Page.astro";
import MobileBar from "../../components/MobileBar.astro";
import { SERVICES, serviceUrl } from "../../data";
import { SERVICES_INTRO, SERVICE_DETAILS } from "../../details";
import { accentClass } from "../../components/ui";
import { ArrowRight } from "lucide-react";

const site = Astro.site!.toString().replace(/\/$/, "");
const schema = [{
  "@context": "https://schema.org",
  "@type": "ItemList",
  itemListElement: SERVICES.map((s, i) => ({ "@type": "ListItem", position: i + 1, name: s.title, url: site + serviceUrl(s.title) })),
}];
---
<Page
  title="Sign Board & Printing Services in Gurugram | Inkwave"
  description="LED & neon sign boards, 3D letters, name plates, flex & vinyl printing, digital printing, safety signs and standees in Gurugram & Delhi NCR."
  breadcrumbs={[{ name: "Services", path: "/services" }]}
  schema={schema}
  h1="Our services"
  lead={SERVICES_INTRO}
>
  <div class="mx-auto grid max-w-6xl gap-5 px-4 sm:px-6 md:grid-cols-2">
    {SERVICES.map((s) => {
      const a = accentClass[s.accent];
      return (
        <a href={serviceUrl(s.title)} class="group flex flex-col rounded-2xl border border-line p-6 transition hover:shadow-md">
          <span class={`grid h-12 w-12 place-items-center rounded-xl ${a.bg} ${a.text}`}><s.icon className="h-6 w-6" /></span>
          <h2 class="mt-4 font-display text-xl font-bold text-fg">{s.title}</h2>
          <p class="mt-1.5 text-mute">{s.desc}</p>
          <ul class="mt-4 flex-1 space-y-1.5 text-sm">
            {SERVICE_DETAILS[s.title].types.map((t) => <li class="border-b border-line/70 pb-1.5 text-fg/85">{t.name}</li>)}
          </ul>
          <span class="mt-5 flex items-center justify-between text-sm"><span class="text-mute">Starting from <b class="text-fg">₹{s.from.toLocaleString("en-IN")}/{s.unit}</b></span><span class="flex items-center gap-1 font-semibold text-fg">Details <ArrowRight className="h-4 w-4 transition group-hover:translate-x-1" /></span></span>
        </a>
      );
    })}
  </div>
  <MobileBar />
</Page>
