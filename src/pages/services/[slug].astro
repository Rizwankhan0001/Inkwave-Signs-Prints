---
import Page from "../../layouts/Page.astro";
import { BRAND, PROCESS, SERVICES, SERVICE_SLUGS, inSentence, serviceUrl } from "../../data";
import { SERVICE_DETAILS } from "../../details";
import { SERVICE_GUIDES, serviceFaqs } from "../../content";
import { accentClass } from "../../components/ui";
import { Check, ChevronDown, MessageCircle } from "lucide-react";
import QuoteForm from "../../components/QuoteForm.astro";
import MobileBar from "../../components/MobileBar.astro";
import { AREAS_LOCAL, localFor, localUrl } from "../../areas";

export function getStaticPaths() {
  return SERVICES.map((s) => ({ params: { slug: SERVICE_SLUGS[s.title] }, props: { title: s.title } }));
}

const { title } = Astro.props;
const s = SERVICES.find((x) => x.title === title)!;
const d = SERVICE_DETAILS[title];
const g = SERVICE_GUIDES[title];
const a = accentClass[s.accent];
const faqs = [...g.faqs, ...serviceFaqs(title, s.from, s.unit, d.turnaround, d.warranty)];
const related = SERVICES.filter((x) => x.title !== title);
const wa = `https://wa.me/${BRAND.phoneRaw}?text=${encodeURIComponent(`Hi! I'm interested in ${title}. Can you share today's price?`)}`;
const site = Astro.site!.toString().replace(/\/$/, "");
const local = localFor(title);

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: title,
    serviceType: title,
    description: g.seoDescription,
    url: site + serviceUrl(title),
    provider: { "@id": `${site}/#business` },
    areaServed: ["Gurugram", "Delhi", "Faridabad", "Noida", "Manesar"],
    offers: { "@type": "Offer", priceCurrency: "INR", price: s.from, priceSpecification: { "@type": "UnitPriceSpecification", price: s.from, priceCurrency: "INR", unitText: s.unit } },
  },
  { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })) },
];
const h2 = "font-display text-2xl font-bold text-fg";
---
<Page
  title={g.seoTitle}
  description={g.seoDescription}
  breadcrumbs={[{ name: "Services", path: "/services" }, { name: title, path: serviceUrl(title) }]}
  schema={schema}
  eyebrow="Service"
  h1={g.h1}
  lead={d.tagline}
>
  <Fragment slot="hero">
    <div class="mt-6 flex flex-wrap gap-x-8 gap-y-2 text-sm">
      <span><span class="text-mute">From</span> <b class="text-fg">₹{s.from.toLocaleString("en-IN")}/{s.unit}</b></span>
      <span><span class="text-mute">Ready in</span> <b class="text-fg">{d.turnaround}</b></span>
      <span><span class="text-mute">Warranty</span> <b class="text-fg">{d.warranty}</b></span>
    </div>
    <div class="mt-7 flex flex-col gap-3 sm:flex-row">
      <a href="#quote-form" class="inline-flex items-center justify-center rounded-full bg-fg px-6 py-3 font-semibold text-ink transition hover:bg-magenta">Get today's price</a>
      <a href={wa} target="_blank" rel="noopener" class="inline-flex items-center justify-center gap-2 rounded-full border border-line bg-ink px-6 py-3 font-semibold text-fg"><MessageCircle className="h-4 w-4 text-[#25D366]" /> Ask on WhatsApp</a>
    </div>
  </Fragment>

  <div class="mx-auto max-w-3xl space-y-12 px-4 sm:px-6">
    <section>
      <h2 class={h2}>About our {inSentence(title)}</h2>
      {[d.overview, ...g.body].map((p) => <p class="mt-4 text-lg leading-relaxed text-fg/80">{p}</p>)}
    </section>

    <section id="types">
      <h2 class={h2}>What we make</h2>
      <div class="mt-4 overflow-hidden rounded-2xl border border-line">
        <table class="w-full text-left text-sm">
          <tbody class="divide-y divide-line">
            {d.types.map((t) => (
              <tr><td class="px-4 py-3"><b class="block text-fg">{t.name}</b><span class="text-mute">{t.note}</span></td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section>
      <h2 class={h2}>Why choose us for {inSentence(title)}</h2>
      <ul class="mt-4 grid gap-3 sm:grid-cols-2">
        {d.features.map((f) => (
          <li class="flex gap-3 text-fg/90"><span class={`mt-0.5 grid h-6 w-6 shrink-0 place-items-center rounded-full ${a.bg} ${a.text}`}><Check className="h-3.5 w-3.5" strokeWidth={3} /></span>{f}</li>
        ))}
      </ul>
      <p class="mt-6 text-mute"><b class="text-fg">Materials:</b> {d.materials.join(", ")}.</p>
      <p class="mt-2 text-mute"><b class="text-fg">Perfect for:</b> {d.idealFor.join(", ")}.</p>
    </section>

    <section id="pricing">
      <h2 class={h2}>Price</h2>
      <p class="mt-3 text-lg text-fg/80">Starting from <b class="text-fg">₹{s.from.toLocaleString("en-IN")} per {s.unit}</b> + GST.</p>
      <p class="mt-3 text-mute">Your exact price depends on:</p>
      <ul class="mt-2 list-inside list-disc space-y-1 text-fg/85">{g.priceFactors.map((f) => <li>{f}</li>)}</ul>
      <p class="mt-3 text-mute">Share your details and we'll send your price on WhatsApp within 10 minutes. Bigger orders get better rates.</p>
      <a href={wa} target="_blank" rel="noopener" class="mt-5 inline-flex items-center gap-2 rounded-full bg-[#25D366] px-6 py-3 font-semibold text-white"><MessageCircle className="h-4 w-4" /> Get today's price on WhatsApp</a>
    </section>

    <section>
      <h2 class={h2}>How it works</h2>
      <ol class="mt-4 space-y-4">
        {PROCESS.map((p) => (
          <li class="flex gap-4"><span class="font-display font-bold text-magenta">{p.step}</span><span><b class="text-fg">{p.title}.</b> <span class="text-mute">{p.desc}</span></span></li>
        ))}
      </ol>
    </section>

    <section>
      <h2 class={h2}>Questions</h2>
      <div class="mt-4 divide-y divide-line border-y border-line">
        {faqs.map((f) => (
          <details class="group">
            <summary class="flex cursor-pointer items-center justify-between gap-6 py-4 font-medium text-fg">{f.q}<ChevronDown className="h-5 w-5 shrink-0 text-mute transition-transform group-open:rotate-180" /></summary>
            <p class="pb-4 leading-relaxed text-mute">{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <QuoteForm service={title} heading={`Get your ${inSentence(title)} price`} />

    {local && (
      <nav aria-label="Areas">
        <h2 class="font-display text-lg font-bold text-fg">{local.keyword} near you</h2>
        <div class="mt-3 flex flex-wrap gap-x-4 gap-y-2 text-sm">
          {AREAS_LOCAL.map((a) => <a href={localUrl(local.slug, a.slug)} class="text-fg/80 hover:text-magenta">{a.name}</a>)}
        </div>
      </nav>
    )}

    {related.length > 0 && (
      <nav aria-label="Related services">
        <h2 class="font-display text-lg font-bold text-fg">Our other services</h2>
        <div class="mt-3 flex flex-wrap gap-2">
          {related.map((r) => <a href={serviceUrl(r.title)} class="rounded-full border border-line px-4 py-2 text-sm text-fg/85 hover:border-fg/30">{r.title}</a>)}
        </div>
      </nav>
    )}
  </div>
  <MobileBar />
</Page>
