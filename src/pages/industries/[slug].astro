---
import Page from "../../layouts/Page.astro";
import { BRAND, INDUSTRIES, INDUSTRY_SLUGS, PROJECTS, SERVICES, industryUrl, serviceUrl } from "../../data";
import { INDUSTRY_DETAILS, SERVICE_DETAILS } from "../../details";
import { accentClass } from "../../components/ui";
import { Check, ArrowRight, MessageCircle } from "lucide-react";

export function getStaticPaths() {
  return INDUSTRIES.map((i) => ({ params: { slug: INDUSTRY_SLUGS[i.title] }, props: { title: i.title } }));
}
const { title } = Astro.props;
const ind = INDUSTRIES.find((i) => i.title === title)!;
const d = INDUSTRY_DETAILS[title];
const products = ind.products.map((t) => SERVICES.find((s) => s.title === t)!);
const others = INDUSTRIES.filter((i) => i.title !== title);
const projects = PROJECTS.filter((p) => products.some((s) => p.tag.toLowerCase().includes(s.title.split(" ")[0].toLowerCase())));
const name = title.toLowerCase();
---
<Page
  title={`Signage & Branding for ${title} in Gurugram | Inkwave`}
  description={`${d.overview.slice(0, 150)}…`}
  breadcrumbs={[{ name: "Industries", path: "/industries" }, { name: title, path: industryUrl(title) }]}
  current="industries"
  eyebrow="Industry"
  h1={`Signage & branding for ${name}`}
  lead={ind.desc}
>
  <Fragment slot="hero">
    <div class="mt-8 flex flex-wrap items-center gap-6">
      <div class="card flex items-center gap-4 rounded-2xl px-5 py-4">
        <span class="font-display text-3xl font-bold text-gradient">{d.stat.value}</span>
        <span class="max-w-[14rem] text-sm text-mute">{d.stat.label}</span>
      </div>
      <a href={`https://wa.me/${BRAND.phoneRaw}?text=${encodeURIComponent(`Hi! I need signage for my ${name} business.`)}`} target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-full bg-fg px-6 py-3.5 font-semibold text-ink transition hover:bg-yellow hover:text-onaccent">
        <MessageCircle className="h-4 w-4" /> Discuss your project
      </a>
    </div>
  </Fragment>

  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <section class="grid gap-10 lg:grid-cols-2">
      <div>
        <h2 class="font-display text-2xl font-bold text-fg sm:text-3xl">How we help {name}</h2>
        <p class="mt-4 leading-relaxed text-fg/80 sm:text-lg">{d.overview}</p>
      </div>
      <div>
        <h2 class="font-display text-xl font-bold text-fg">What we handle</h2>
        <ul class="mt-4 grid gap-3">
          {d.handles.map((h) => (
            <li class="card flex gap-3 rounded-2xl p-4 text-fg/90">
              <span class="mt-0.5 grid h-6 w-6 shrink-0 place-items-center rounded-full bg-magenta/10 text-magenta"><Check className="h-3.5 w-3.5" strokeWidth={3} /></span>{h}
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="mt-16">
      <h2 class="font-display text-2xl font-bold text-fg sm:text-3xl">Recommended products</h2>
      <div class="mt-6 grid gap-4 md:grid-cols-3">
        {products.map((s) => {
          const a = accentClass[s.accent];
          return (
            <a href={serviceUrl(s.title)} class="card group flex flex-col rounded-3xl p-6 transition hover:-translate-y-1 hover:border-fg/25">
              <span class={`grid h-12 w-12 place-items-center rounded-2xl ${a.bg} ${a.text}`}><s.icon className="h-6 w-6" /></span>
              <h3 class="mt-5 font-display text-xl font-semibold text-fg">{s.title}</h3>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-mute">{SERVICE_DETAILS[s.title].overview}</p>
              <span class="mt-5 flex items-center gap-1 text-sm font-medium text-cyan">from ₹{s.from.toLocaleString("en-IN")}/{s.unit} <ArrowRight className="h-4 w-4 transition group-hover:translate-x-1" /></span>
            </a>
          );
        })}
      </div>
    </section>

    {projects.length > 0 && (
      <section class="mt-16">
        <h2 class="font-display text-2xl font-bold text-fg sm:text-3xl">Related work</h2>
        <div class="mt-6 grid gap-4 md:grid-cols-2">
          {projects.slice(0, 4).map((p) => (
            <div class="card rounded-3xl p-6">
              <span class="rounded-full border border-line px-3 py-1 text-xs text-mute">{p.tag}</span>
              <h3 class="mt-3 font-display text-lg font-semibold text-fg">{p.title}</h3>
              <p class="text-sm text-mute">{p.client} · {p.time}</p>
              <p class="mt-3 text-sm leading-relaxed text-fg/80">{p.result}</p>
            </div>
          ))}
        </div>
      </section>
    )}

    <nav class="mt-16" aria-label="Other industries">
      <h2 class="font-display text-xl font-bold text-fg">Other industries we serve</h2>
      <div class="mt-4 flex flex-wrap gap-2">
        {others.map((o) => <a href={industryUrl(o.title)} class="flex items-center gap-2 rounded-full border border-line px-4 py-2 text-sm text-fg/85 transition hover:border-fg/30 hover:text-fg"><o.icon className="h-4 w-4 text-cyan" />{o.title}</a>)}
      </div>
    </nav>
  </div>
</Page>
