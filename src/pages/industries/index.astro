---
import Page from "../../layouts/Page.astro";
import { INDUSTRIES, industryUrl } from "../../data";
import { INDUSTRY_DETAILS } from "../../details";
import { ArrowRight } from "lucide-react";
---
<Page
  title="Industries We Serve — Retail, Offices, Restaurants & More | Inkwave"
  description="Signage and printing for retail, corporate offices, cafés, clinics, homes, events, schools and hotels across Gurugram & Delhi NCR."
  breadcrumbs={[{ name: "Industries", path: "/industries" }]}
  current="industries"
  eyebrow="Industries"
  h1="Signage made for your industry"
  lead="Every industry has its own rules: visibility, safety codes, durability, deadlines. Here's what we usually make for each one."
>
  <div class="mx-auto grid max-w-7xl gap-4 px-4 sm:grid-cols-2 sm:px-6 lg:grid-cols-4">
    {INDUSTRIES.map((i) => (
      <a href={industryUrl(i.title)} class="card group flex flex-col rounded-3xl p-6 transition hover:-translate-y-1 hover:border-fg/25">
        <i.icon className="h-8 w-8 text-cyan" strokeWidth={1.5} />
        <h2 class="mt-5 font-display text-lg font-semibold text-fg">{i.title}</h2>
        <p class="mt-2 flex-1 text-sm leading-relaxed text-mute">{i.desc}</p>
        <div class="mt-5 flex items-center justify-between border-t border-line pt-4 text-sm">
          <span class="font-display font-bold text-gradient">{INDUSTRY_DETAILS[i.title].stat.value}</span>
          <ArrowRight className="h-4 w-4 text-cyan transition group-hover:translate-x-1" />
        </div>
      </a>
    ))}
  </div>
</Page>
