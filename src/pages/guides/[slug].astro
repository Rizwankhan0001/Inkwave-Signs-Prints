---
import Page from "../../layouts/Page.astro";
import { BRAND, SERVICES, serviceUrl } from "../../data";
import { GUIDES } from "../../content";
import { accentClass } from "../../components/ui";
import { CalendarDays, Clock, ArrowRight, ChevronDown } from "lucide-react";

export function getStaticPaths() {
  return GUIDES.map((g) => ({ params: { slug: g.slug }, props: { guide: g } }));
}
const { guide: g } = Astro.props;
const site = Astro.site!.toString().replace(/\/$/, "");
const related = g.related.map((t) => SERVICES.find((s) => s.title === t)!);
const more = GUIDES.filter((x) => x.slug !== g.slug);
const dateLabel = new Date(g.date).toLocaleDateString("en-IN", { day: "numeric", month: "long", year: "numeric" });
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: g.title,
    description: g.description,
    datePublished: g.date,
    dateModified: g.date,
    author: { "@type": "Organization", name: BRAND.full, url: site },
    publisher: { "@id": `${site}/#business` },
    image: `${site}/og-image.png`,
    mainEntityOfPage: `${site}/guides/${g.slug}`,
  },
  { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: g.faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })) },
];
---
<Page
  title={`${g.title} | Inkwave`}
  description={g.description}
  breadcrumbs={[{ name: "Guides", path: "/guides" }, { name: g.title, path: `/guides/${g.slug}` }]}
  schema={schema}
  current="guides"
  eyebrow="Price guide"
  h1={g.title}
  lead={g.description}
>
  <Fragment slot="hero">
    <div class="mt-6 flex flex-wrap gap-4 text-sm text-mute">
      <span class="flex items-center gap-1.5"><CalendarDays className="h-4 w-4" /> Updated {dateLabel}</span>
      <span class="flex items-center gap-1.5"><Clock className="h-4 w-4" /> {g.readMins} min read</span>
    </div>
  </Fragment>

  <div class="mx-auto grid max-w-7xl gap-12 px-4 sm:px-6 lg:grid-cols-[minmax(0,720px)_1fr]">
    <article class="min-w-0">
      {g.sections.map((sec) => (
        <section class="mb-10">
          <h2 class="font-display text-2xl font-bold text-fg">{sec.h}</h2>
          {sec.p?.map((p) => <p class="mt-4 leading-relaxed text-fg/80 sm:text-lg">{p}</p>)}
          {sec.list && (
            <ul class="mt-4 space-y-2.5">
              {sec.list.map((li) => <li class="flex gap-3 text-fg/85"><span class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-magenta"></span><span>{li}</span></li>)}
            </ul>
          )}
          {sec.table && (
            <div class="no-scrollbar mt-5 overflow-x-auto rounded-2xl border border-line">
              <table class="w-full min-w-[520px] text-left text-sm">
                <thead class="bg-fg/5 text-fg">
                  <tr>{sec.table.head.map((h) => <th class="px-4 py-3 font-semibold">{h}</th>)}</tr>
                </thead>
                <tbody class="divide-y divide-line">
                  {sec.table.rows.map((r) => <tr>{r.map((c, i) => <td class={`px-4 py-3 ${i === 0 ? "font-medium text-fg" : "text-fg/80"}`}>{c}</td>)}</tr>)}
                </tbody>
              </table>
            </div>
          )}
        </section>
      ))}

      <section class="mb-10">
        <h2 class="font-display text-2xl font-bold text-fg">FAQs</h2>
        <div class="mt-4 divide-y divide-line border-y border-line">
          {g.faqs.map((f) => (
            <details class="group py-1">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-4 font-display text-base font-medium text-fg sm:text-lg [&::-webkit-details-marker]:hidden">
                {f.q}<ChevronDown className="h-5 w-5 shrink-0 text-cyan transition-transform group-open:rotate-180" />
              </summary>
              <p class="pb-4 leading-relaxed text-mute">{f.a}</p>
            </details>
          ))}
        </div>
      </section>

      <p class="rounded-2xl border border-line bg-fg/[0.03] p-4 text-sm text-mute">Prices are indicative for Gurugram & Delhi NCR in 2026 and exclude GST. Material costs change, so ask us for a current quote.</p>
    </article>

    <aside class="space-y-4 lg:sticky lg:top-24 lg:self-start">
      <div class="card rounded-3xl p-5">
        <h2 class="font-display text-sm font-semibold uppercase tracking-wider text-mute">Products in this guide</h2>
        <ul class="mt-3 space-y-1">
          {related.map((s) => {
            const a = accentClass[s.accent];
            return (
              <li><a href={serviceUrl(s.title)} class="flex items-center gap-3 rounded-xl p-2 transition hover:bg-fg/5">
                <span class={`grid h-9 w-9 place-items-center rounded-lg ${a.bg} ${a.text}`}><s.icon className="h-4 w-4" /></span>
                <span class="flex-1 text-sm"><span class="block font-medium text-fg">{s.title}</span><span class="text-xs text-mute">from ₹{s.from.toLocaleString("en-IN")}/{s.unit}</span></span>
              </a></li>
            );
          })}
        </ul>
        <a href="/#quote" class="mt-4 flex items-center justify-center gap-2 rounded-full bg-gradient-to-r from-magenta to-yellow py-3 text-sm font-semibold text-onaccent">Get your exact price</a>
      </div>
      <div class="card rounded-3xl p-5">
        <h2 class="font-display text-sm font-semibold uppercase tracking-wider text-mute">More guides</h2>
        <ul class="mt-3 space-y-1">
          {more.map((m) => <li><a href={`/guides/${m.slug}`} class="flex items-start justify-between gap-2 rounded-xl p-2 text-sm text-fg/85 transition hover:bg-fg/5 hover:text-fg">{m.title}<ArrowRight className="mt-0.5 h-4 w-4 shrink-0 text-mute" /></a></li>)}
        </ul>
      </div>
    </aside>
  </div>
</Page>
