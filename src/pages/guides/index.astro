---
import Page from "../../layouts/Page.astro";
import { GUIDES } from "../../content";
import { ArrowRight, Clock } from "lucide-react";
const sorted = [...GUIDES].sort((a, b) => b.date.localeCompare(a.date));
---
<Page
  title="Signage & Printing Price Guides (2026) | Inkwave Gurugram"
  description="Honest price guides for LED sign boards, name plates, flex, vinyl and sunboard printing in Gurugram, plus checklists before you order."
  breadcrumbs={[{ name: "Guides", path: "/guides" }]}
  current="guides"
  eyebrow="Guides"
  h1="Price guides & buying advice"
  lead="Straight answers on what signage and printing cost in Gurugram, and how to choose the right option the first time."
>
  <div class="mx-auto grid max-w-7xl gap-4 px-4 sm:px-6 md:grid-cols-2">
    {sorted.map((g) => (
      <a href={`/guides/${g.slug}`} class="card group flex flex-col rounded-3xl p-6 transition hover:-translate-y-1 hover:border-fg/25 sm:p-8">
        <span class="flex items-center gap-1.5 text-xs text-mute"><Clock className="h-3.5 w-3.5" /> {g.readMins} min read</span>
        <h2 class="mt-3 font-display text-xl font-bold text-fg sm:text-2xl">{g.title}</h2>
        <p class="mt-2 flex-1 text-sm leading-relaxed text-mute">{g.description}</p>
        <span class="mt-5 flex items-center gap-1 text-sm font-medium text-cyan">Read guide <ArrowRight className="h-4 w-4 transition group-hover:translate-x-1" /></span>
      </a>
    ))}
  </div>
</Page>
