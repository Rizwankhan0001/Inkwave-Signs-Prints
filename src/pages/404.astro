  <div class="mx-auto flex max-w-7xl flex-wrap gap-3 px-4 sm:px-6">
    <a href="/" class="rounded-full bg-fg px-6 py-3 font-semibold text-ink">Go to home</a>
    <a href="/services" class="rounded-full border border-line px-6 py-3 font-semibold text-fg">Browse services</a>
    <a href="/#contact" class="rounded-full border border-line px-6 py-3 font-semibold text-fg">Contact us</a>
  </div>
</Page>
