---
import Page from "../../layouts/Page.astro";
import { BRAND, SERVICES, serviceUrl } from "../../data";
import { AREA_PAGES } from "../../content";
import { SERVICE_DETAILS } from "../../details";
import { accentClass } from "../../components/ui";
import { MapPin, Truck, ArrowRight, Phone } from "lucide-react";

export function getStaticPaths() {
  return AREA_PAGES.map((a) => ({ params: { slug: a.slug }, props: { area: a } }));
}
const { area } = Astro.props;
const products = area.popular.map((t) => SERVICES.find((s) => s.title === t)!);
const others = AREA_PAGES.filter((a) => a.slug !== area.slug);
const site = Astro.site!.toString().replace(/\/$/, "");
const schema = [{
  "@context": "https://schema.org",
  "@type": "Service",
  name: `Signage & printing in ${area.name}`,
  provider: { "@id": `${site}/#business` },
  areaServed: { "@type": "Place", name: area.name },
  url: `${site}/areas/${area.slug}`,
}];
---
<Page
  title={area.seoTitle}
  description={area.seoDescription}
  breadcrumbs={[{ name: "Areas", path: "/areas" }, { name: area.name, path: `/areas/${area.slug}` }]}
  schema={schema}
  current="areas"
  eyebrow="Service area"
  h1={`Signage & printing in ${area.name}`}
  lead={area.intro}
>
  <Fragment slot="hero">
    <div class="mt-8 flex flex-wrap gap-3">
      <span class="card inline-flex items-center gap-2 rounded-full px-4 py-2 text-sm text-fg"><Truck className="h-4 w-4 text-cyan" />{area.visit}</span>
      <a href={`tel:${BRAND.phoneRaw}`} class="inline-flex items-center gap-2 rounded-full bg-fg px-5 py-2 text-sm font-semibold text-ink transition hover:bg-yellow hover:text-onaccent"><Phone className="h-4 w-4" />Book a site visit</a>
    </div>
  </Fragment>

  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <section class="grid gap-10 lg:grid-cols-[1.4fr_1fr]">
      <div>
        <h2 class="font-display text-2xl font-bold text-fg sm:text-3xl">What businesses in {area.name} order</h2>
        <p class="mt-4 leading-relaxed text-fg/80 sm:text-lg">{area.detail}</p>
      </div>
      <div class="card rounded-3xl p-6">
        <h2 class="font-display text-lg font-bold text-fg">Localities we cover</h2>
        <ul class="mt-4 flex flex-wrap gap-2">
          {area.localities.map((l) => <li class="flex items-center gap-1.5 rounded-full bg-fg/5 px-3 py-1.5 text-sm text-fg/85"><MapPin className="h-3.5 w-3.5 text-magenta" />{l}</li>)}
        </ul>
      </div>
    </section>

    <section class="mt-16">
      <h2 class="font-display text-2xl font-bold text-fg sm:text-3xl">Popular in {area.name}</h2>
      <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {products.map((s) => {
          const a = accentClass[s.accent];
          return (
            <a href={serviceUrl(s.title)} class="card group flex flex-col rounded-3xl p-5 transition hover:-translate-y-1 hover:border-fg/25">
              <span class={`grid h-11 w-11 place-items-center rounded-xl ${a.bg} ${a.text}`}><s.icon className="h-5 w-5" /></span>
              <h3 class="mt-4 font-display text-lg font-semibold text-fg">{s.title}</h3>
              <p class="mt-1 flex-1 text-sm text-mute">{SERVICE_DETAILS[s.title].tagline}</p>
              <span class="mt-4 flex items-center gap-1 text-sm font-medium text-cyan">from ₹{s.from.toLocaleString("en-IN")}/{s.unit} <ArrowRight className="h-4 w-4" /></span>
            </a>
          );
        })}
      </div>
    </section>

    <nav class="mt-16" aria-label="Other areas">
      <h2 class="font-display text-xl font-bold text-fg">Other areas we serve</h2>
      <div class="mt-4 flex flex-wrap gap-2">
        {others.map((o) => <a href={`/areas/${o.slug}`} class="rounded-full border border-line px-4 py-2 text-sm text-fg/85 transition hover:border-fg/30 hover:text-fg">{o.name}</a>)}
      </div>
    </nav>
  </div>
</Page>
