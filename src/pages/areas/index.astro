---
import Page from "../../layouts/Page.astro";
import MobileBar from "../../components/MobileBar.astro";
import { AREAS_LOCAL, areaUrl, visitTime } from "../../areas";
const regions = ["Gurugram", "Delhi", "Faridabad", "Noida"] as const;
---
<Page
  title="Areas We Serve in Gurugram & Delhi NCR | Inkwave"
  description="Sign board maker serving Gurugram, Cyber City, Golf Course Road, Sohna Road, Manesar, Dwarka, Delhi, Faridabad and Noida. Free site visit and mock-up."
  breadcrumbs={[{ name: "Areas", path: "/areas" }]}
  h1="Areas we serve"
  lead="Our workshop is in Udyog Vihar, Gurugram. We visit, measure and install across Delhi NCR. Pick your area for local prices and visit times."
>
  <div class="mx-auto max-w-6xl space-y-10 px-4 sm:px-6">
    {regions.map((r) => (
      <section>
        <h2 class="font-display text-2xl font-bold text-fg">{r}</h2>
        <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
          {AREAS_LOCAL.filter((a) => a.region === r).map((a) => (
            <a href={areaUrl(a.slug)} class="rounded-2xl border border-line p-4 transition hover:shadow-md">
              <span class="block font-display font-semibold text-fg">{a.name}</span>
              <span class="mt-1 block text-xs text-mute">{visitTime(a.km).visit}</span>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>
  <MobileBar quoteHref="/#estimate" />
</Page>
