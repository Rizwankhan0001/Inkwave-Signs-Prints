---
import { BRAND } from "../data";
---
<a href="/" class="flex shrink-0 items-center gap-2.5" aria-label={`${BRAND.full} home`}>
  <img src="/favicon.svg" alt="" width="36" height="36" class="h-9 w-9" />
  <span class="font-display text-lg font-bold leading-none tracking-tight text-fg">
    {BRAND.name}
    <span class="block text-[10px] font-medium uppercase tracking-[0.25em] text-mute">Signs &amp; Prints</span>
  </span>
</a>
