---
import Logo from "./Logo.astro";
import { BRAND, SERVICES, serviceUrl } from "../data";
import { AREAS_LOCAL, areaUrl } from "../areas";
const year = new Date().getFullYear();
---
<footer class="border-t border-line bg-ink-2">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 sm:px-6 md:grid-cols-[1.2fr_2fr_1.2fr]">
    <div>
      <Logo />
      <p class="mt-4 max-w-xs text-sm leading-relaxed text-mute">Sign boards, name plates and printing, made in our Gurugram workshop and installed across Delhi NCR.</p>
    </div>
    <div>
      <h2 class="font-display text-sm font-semibold text-fg">Services</h2>
      <ul class="mt-4 grid grid-cols-2 gap-x-6 gap-y-2 text-sm text-mute">
        {SERVICES.map((s) => <li><a href={serviceUrl(s.title)} class="transition hover:text-fg">{s.title}</a></li>)}
      </ul>
    </div>
    <div>
      <h2 class="font-display text-sm font-semibold text-fg">Contact</h2>
      <ul class="mt-4 space-y-2 text-sm text-mute">
        <li><a href={`tel:${BRAND.phoneRaw}`} class="transition hover:text-fg">{BRAND.phone}</a></li>
        <li><a href={`mailto:${BRAND.email}`} class="transition hover:text-fg">{BRAND.email}</a></li>
        <li>{BRAND.address}</li>
        <li>{BRAND.hours}</li>
      </ul>
    </div>
  </div>
  <div class="mx-auto max-w-6xl px-4 pb-10 sm:px-6">
    <h2 class="font-display text-sm font-semibold text-fg">Areas we serve</h2>
    <p class="mt-3 flex flex-wrap gap-x-4 gap-y-1.5 text-sm text-mute">
      {AREAS_LOCAL.map((a) => <a href={areaUrl(a.slug)} class="hover:text-fg">{a.name}</a>)}
    </p>
  </div>
  <div class="border-t border-line">
    <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-2 px-4 py-5 pb-24 text-xs text-mute sm:flex-row sm:px-6 sm:pb-5">
      <p>© {year} {BRAND.full}. All rights reserved.</p>
      <p class="flex gap-4"><a href="/privacy" class="hover:text-fg">Privacy</a><a href="/terms" class="hover:text-fg">Terms</a></p>
    </div>
  </div>
</footer>
