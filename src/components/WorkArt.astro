---
/* Placeholder artwork for each project until real photos are added.
   To use a photo instead, replace <WorkArt> with <img src="/work/your-photo.webp" alt="…">. */
import type { Project } from "../data";
interface Props { style: Project["style"] }
const { style } = Astro.props;
---
{style === "letters" && (
  <div class="absolute inset-0 grid place-items-center bg-[radial-gradient(ellipse_at_center,#3a2a10,#0e0b07_70%)]">
    <div class="text-center">
      <div class="font-display text-3xl font-bold tracking-tight text-[#ffe8b0]" style="text-shadow: 0 0 30px rgb(255 184 0 / .8), 0 0 80px rgb(255 184 0 / .5)">BREW&amp;BEAN</div>
      <div class="mt-2 text-[10px] uppercase tracking-[0.5em] text-[#ffb800]/70">coffee roasters</div>
    </div>
  </div>
)}
{style === "neon" && (
  <div class="absolute inset-0 grid place-items-center bg-[radial-gradient(ellipse_at_center,#2a0a1a,#0a0509_70%)]">
    <div class="neon font-display text-4xl font-bold italic">glow</div>
  </div>
)}
{style === "plate" && (
  <div class="absolute inset-0 grid place-items-center bg-gradient-to-br from-[#3b3b44] to-[#1c1c22]">
    <div class="rounded-md bg-gradient-to-br from-[#f7e19a] via-[#c9a13b] to-[#7c5e14] px-6 py-4 text-center shadow-2xl">
      <div class="font-display text-lg font-bold text-[#14141f]">The Kapoors</div>
      <div class="text-[10px] uppercase tracking-widest text-[#14141f]/70">Villa 21</div>
    </div>
  </div>
)}
{style === "glass" && (
  <div class="absolute inset-0 bg-gradient-to-br from-[#0e2a3a] to-[#07131b]">
    <div class="absolute inset-y-5 left-5 right-1/2 rounded-lg border border-white/20 bg-white/10"></div>
    <div class="absolute inset-y-5 left-1/2 right-5 ml-2 rounded-lg border border-white/20 bg-white/10"></div>
    <div class="absolute inset-0 grid place-items-center font-display text-2xl font-bold tracking-[0.3em] text-white/80">NIMBUS</div>
  </div>
)}
{style === "standee" && (
  <div class="absolute inset-0 flex items-end justify-center gap-3 bg-gradient-to-b from-[#101a33] to-[#080b14] pb-5">
    {["from-[#00c2ff] to-[#0050ff]", "from-[#ff3d7f] to-[#7a00ff]", "from-[#ffb800] to-[#ff5a00]"].map((g) => (
      <div class={`h-[70%] w-12 rounded-t-sm bg-gradient-to-b ${g} p-1.5 shadow-xl`}>
        <div class="h-2 w-full rounded-sm bg-white/70"></div>
        <div class="mt-1 h-1 w-2/3 rounded-sm bg-white/50"></div>
      </div>
    ))}
  </div>
)}
{style === "flex" && (
  <div class="absolute inset-0 grid place-items-center bg-[linear-gradient(135deg,#ff3d7f,#ffb800)] text-center">
    <div>
      <div class="font-display text-3xl font-black uppercase text-[#14141f]">Mega Sale</div>
      <div class="font-display text-base font-bold text-[#14141f]/80">upto 60% off</div>
    </div>
  </div>
)}
