---
/* Shell for inner pages: header, breadcrumbs, page title, footer. */
import Base, { type Crumb } from "./Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";

interface Props {
  title: string;
  description: string;
  breadcrumbs: Crumb[];
  schema?: object[];
  eyebrow?: string;
  h1: string;
  lead?: string;
  noindex?: boolean;
}
const { title, description, breadcrumbs, schema, eyebrow, h1, lead, noindex } = Astro.props;
---
<Base title={title} description={description} breadcrumbs={breadcrumbs} schema={schema} noindex={noindex}>
  <Header />
  <main id="main">
    <header class="border-b border-line bg-ink-2">
      <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6 sm:py-14">
        <nav aria-label="Breadcrumb" class="mb-5 text-sm text-mute">
          <ol class="flex flex-wrap items-center gap-1.5">
            <li><a href="/" class="hover:text-fg">Home</a></li>
            {breadcrumbs.map((c, i) => (
              <li class="flex items-center gap-1.5">
                <span aria-hidden="true">/</span>
                {i === breadcrumbs.length - 1 ? <span class="text-fg" aria-current="page">{c.name}</span> : <a href={c.path} class="hover:text-fg">{c.name}</a>}
              </li>
            ))}
          </ol>
        </nav>
        {eyebrow && <p class="mb-3 text-sm font-medium text-magenta">{eyebrow}</p>}
        <h1 class="max-w-3xl text-balance font-display text-4xl font-bold leading-tight tracking-tight text-fg sm:text-5xl">{h1}</h1>
        {lead && <p class="mt-4 max-w-2xl text-lg leading-relaxed text-mute">{lead}</p>}
        <slot name="hero" />
      </div>
    </header>
    <div class="py-12 sm:py-16"><slot /></div>
  </main>
  <Footer />
  <WhatsAppButton />
</Base>
